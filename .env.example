# ==========================================
# CallGuardianAI — Environment Configuration
# ==========================================

# 1. Google Gemini API (Required for AI Reasoning & Screening)
# Get a key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite

# 2. Cartesia Sonic API (Recommended: Ultra-Low-Latency Sub-150ms Neural Voice)
# Get a key at https://cartesia.ai/
CARTESIA_API_KEY=your_cartesia_api_key_here

# 3. Daily.co API (Optional: Cloud WebRTC Telephony & Full-Duplex Audio)
# Get a free key (10,000 mins/mo free) at https://daily.co/
DAILY_API_KEY=your_daily_api_key_here

# 4. NVIDIA NIM Cloud API (Optional: Alternative Neural Human TTS Voice)
# Get a key at https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here

# 5. Server Configuration (Optional defaults)
HOST=127.0.0.1
PORT=8001
CALLGUARDIAN_CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
