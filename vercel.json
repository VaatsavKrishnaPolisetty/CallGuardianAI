{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "fastapi"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/config-status",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/captcha",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/auth/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/chat",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/calls",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/calls/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/analytics/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/export/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/vault",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/vault/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/crm",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/tts",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/tts/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
